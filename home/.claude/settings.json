{
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "~/cursor-config"
    ],
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "TodoWrite",
      "Agent",
      "NotebookEdit",
      "ExitPlanMode",
      "BashOutput",
      "KillShell"
    ]
  },
  "autoMemoryEnabled": false,
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/claude-permissions/src/pre-hook.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/claude-permissions/src/post-hook.ts"
          }
        ]
      }
    ]
  }
}
